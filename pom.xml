			<groupId>org.apache.jena</groupId>
			<artifactId>jena-arq</artifactId>
			<exclusions>
				<exclusion>
					<!-- Bundles the Jakarta JSON-P 2.0 API and shadows the 2.1 API the ES 9 client needs. -->
					<groupId>org.glassfish</groupId>
					<artifactId>jakarta.json</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<!-- jena-arq excludes libthrift via snomed-parent-bom; declare it directly so Jena RIOT (Thrift) initialises. Version managed by BOM. -->
			<groupId>org.apache.thrift</groupId>
			<artifactId>libthrift</artifactId>
		</dependency>
		<dependency>
			<!--
			Jakarta JSON-P 2.1 API (Parsson supplies the impl), required by the Elasticsearch 9
			client for JsonConfig.KeyStrategy. Declared directly so it lands ahead of Jena's
			org.glassfish:jakarta.json 2.0.1, which bundles the 2.0 API and would shadow it -
			without that, every spring-data-elasticsearch repository fails to instantiate.
			Version managed by Spring Boot via the BOM.
			-->
			<groupId>jakarta.json</groupId>
			<artifactId>jakarta.json-api</artifactId>
		</dependency>

